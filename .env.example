# 루트 실행 스크립트와 Docker Compose에서 사용하는 기본값입니다.
FRONTEND_PORT=5173
DASHBOARD_PORT=5000
DETECTOR_PORT=8888

# 브라우저와 클라이언트가 접속할 호스트입니다.
# 같은 PC에서 테스트할 때는 localhost를 사용합니다.
# 팀원 또는 장비 연동 테스트에서는 대시보드 PC의 내부망 IP를 사용합니다.
PUBLIC_HOST=localhost

# Docker Compose 통신에 사용하는 호스트명입니다.
# 기본값은 호스트 PC의 가상환경 데모 서버를 바라봅니다.
# demo-docker profile로 데모 서버까지 Docker에서 실행할 때는 COMPOSE_DETECTOR_HOST=demo-server로 바꿉니다.
COMPOSE_BACKEND_HOST=backend
COMPOSE_DETECTOR_HOST=host.docker.internal

SERIAL_PORT=
BAUD_RATE=9600
VIDEO_SOURCE=../dashboard-web/public/wrongway_test.mp4

# Docker Compose PostgreSQL 개발 DB 설정입니다.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
