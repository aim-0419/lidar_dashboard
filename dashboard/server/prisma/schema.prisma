generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String         @id @default(cuid())
  userId           String         @unique @map("user_id")
  name             String
  passwordHash     String         @map("password_hash")
  email            String?        @unique
  phoneNumber      String?        @unique @map("phone_number")
  role             String         @default("MANAGER")
  isActive         Boolean        @default(true) @map("is_active")
  sessionVersion   Int            @default(0) @map("session_version")
  lastLoginAt      DateTime?      @map("last_login_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  eventLogs        EventLog[]
  refreshTokens    RefreshToken[]
  reviewedSignupRequests SignupRequest[] @relation("SignupRequestReviewer")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

model SignupRequest {
  id               String    @id @default(cuid())
  userId           String?   @map("user_id")
  name             String?
  passwordHash     String?   @map("password_hash")
  email            String?
  phoneNumber      String?   @map("phone_number")
  requestedRole    String    @default("MANAGER") @map("requested_role")
  status           String    @default("PENDING")
  expiresAt        DateTime  @map("expires_at")
  reviewedByUserId String?   @map("reviewed_by_user_id")
  reviewedAt       DateTime? @map("reviewed_at")
  rejectReason     String?   @map("reject_reason")
  anonymizedAt     DateTime? @map("anonymized_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  reviewedBy User? @relation("SignupRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([expiresAt])
  @@index([anonymizedAt])
  @@index([userId, status])
  @@index([email, status])
  @@index([phoneNumber, status])
  @@index([createdAt])
  @@index([reviewedByUserId])
  @@map("signup_requests")
}

model Site {
  id          String   @id @default(cuid())
  name        String
  location    String?
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  zones       Zone[]

  @@map("sites")
}

model Zone {
  id            String             @id @default(cuid())
  siteId        String             @map("site_id")
  zoneCode      String?            @unique @map("zone_code")
  name          String
  type          String?
  description   String?
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  site          Site               @relation(fields: [siteId], references: [id])
  devices       Device[]
  vehicleTracks VehicleTrack[]
  trafficEvents TrafficEvent[]
  incidents     SafetyIncident[]
  dailyStats    DailyTrafficStat[]

  @@index([siteId])
  @@map("zones")
}

model Device {
  id                String             @id @default(cuid())
  zoneId            String             @map("zone_id")
  deviceCode        String?            @unique @map("device_code")
  name              String
  deviceType        String             @map("device_type")
  status            String             @default("UNKNOWN")
  healthStatus      String             @default("UNKNOWN") @map("health_status")
  ipAddress         String?            @map("ip_address")
  port              Int?
  lastSeenAt        DateTime?          @map("last_seen_at")
  installedLocation String?            @map("installed_location")
  controllerId      String?            @map("controller_id")
  protocolDeviceId  Int?               @map("protocol_device_id")
  powerStatus       String             @default("UNKNOWN") @map("power_status")
  operationStatus   String             @default("UNKNOWN") @map("operation_status")
  statusCheckedAt   DateTime?          @map("status_checked_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  zone              Zone               @relation(fields: [zoneId], references: [id])
  controller        Device?            @relation("ControlledDevices", fields: [controllerId], references: [id], onDelete: SetNull)
  controlledDevices Device[]           @relation("ControlledDevices")
  vehicleTracks     VehicleTrack[]
  trafficEvents     TrafficEvent[]
  incidents         SafetyIncident[]
  dailyStats        DailyTrafficStat[]
  controlCommands   ControlCommand[]   @relation("ControlBoardCommands")
  targetCommands    ControlCommand[]   @relation("TargetDeviceCommands")

  @@unique([controllerId, protocolDeviceId])
  @@index([zoneId])
  @@index([controllerId])
  @@index([deviceType])
  @@index([status])
  @@index([healthStatus])
  @@map("devices")
}

model TrafficEvent {
  id                       String          @id @default(cuid())
  eventCode                String?         @unique @map("event_code")
  eventType                String          @map("event_type")
  status                   String          @default("NEW")
  occurredAt               DateTime?       @map("occurred_at")
  receivedAt               DateTime        @default(now()) @map("received_at")
  zoneId                   String?         @map("zone_id")
  deviceId                 String?         @map("device_id")
  incidentId               String?         @map("incident_id")
  vehicleTrackId           String?         @map("vehicle_track_id")
  externalZoneId           String?         @map("external_zone_id")
  trackId                  String?         @map("track_id")
  warningLevel             Int?            @map("warning_level")
  confidence               Float?
  message                  String?
  speedMs                  Float?          @map("speed_ms")
  speedKmh                 Float?          @map("speed_kmh")
  objectClass              Int?            @map("object_class")
  objectUuid               String?         @map("object_uuid")
  description              String?
  consecutiveCount         Int?            @map("consecutive_count")
  isConfirmed              Boolean?        @map("is_confirmed")
  normalMovingVehicleCount Int?            @map("normal_moving_vehicle_count")
  rawPayload               Json            @map("raw_payload")
  createdAt                DateTime        @default(now()) @map("created_at")
  updatedAt                DateTime        @updatedAt @map("updated_at")
  zone                     Zone?           @relation(fields: [zoneId], references: [id])
  device                   Device?         @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  incident                 SafetyIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  vehicleTrack             VehicleTrack?   @relation(fields: [vehicleTrackId], references: [id], onDelete: SetNull)
  eventLogs                EventLog[]

  @@index([zoneId])
  @@index([deviceId])
  @@index([incidentId])
  @@index([vehicleTrackId])
  @@index([externalZoneId])
  @@index([trackId])
  @@index([eventType])
  @@index([warningLevel])
  @@index([status])
  @@index([occurredAt])
  @@index([receivedAt])
  @@map("traffic_events")
}

model VehicleTrack {
  id                           String         @id @default(cuid())
  deviceId                     String?        @map("device_id")
  trackId                      String         @map("track_id")
  zoneId                       String?        @map("zone_id")
  externalZoneId               String?        @map("external_zone_id")
  lastEventType                String?        @map("last_event_type")
  lastWarningLevel             Int?           @map("last_warning_level")
  objectClass                  Int?           @map("object_class")
  lastConfidence               Float?         @map("last_confidence")
  lastSpeedMs                  Float?         @map("last_speed_ms")
  lastSpeedKmh                 Float?         @map("last_speed_kmh")
  isActive                     Boolean        @default(true) @map("is_active")
  endedAt                      DateTime?      @map("ended_at")
  firstSeenAt                  DateTime       @default(now()) @map("first_seen_at")
  lastSeenAt                   DateTime       @default(now()) @map("last_seen_at")
  lastNormalMovingVehicleCount Int?           @map("last_normal_moving_vehicle_count")
  rawPayload                   Json?          @map("raw_payload")
  createdAt                    DateTime       @default(now()) @map("created_at")
  updatedAt                    DateTime       @updatedAt @map("updated_at")
  zone                         Zone?          @relation(fields: [zoneId], references: [id])
  device                       Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  trafficEvents                TrafficEvent[]

  @@unique([deviceId, trackId])
  @@index([deviceId])
  @@index([zoneId])
  @@index([externalZoneId])
  @@index([lastEventType])
  @@index([lastSeenAt])
  @@map("vehicle_tracks")
}

model TrafficStatistic {
  id String @id @default(cuid())

  // 기준 날짜
  statDate DateTime @map("stat_date")

  // 시간대
  hourSlot Int? @map("hour_slot")

  // hourly | daily | weekly | monthly
  periodType String @map("period_type")

  // 현장 기준 통계
  siteId String? @map("site_id")

  // 구역 기준 통계
  zoneId String? @map("zone_id")

  // 통과 차량 수
  totalVehicles Int @default(0) @map("total_vehicles")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([statDate])
  @@index([periodType])
  @@index([siteId])
  @@index([zoneId])
  @@index([statDate, periodType])

  // 같은 시간대 통계 row 중복 방지
  @@unique([statDate, hourSlot, periodType, siteId, zoneId])

  @@map("traffic_statistics")
}

model SafetyIncident {
  id              String           @id @default(cuid())
  zoneId          String           @map("zone_id")
  sourceDeviceId  String           @map("source_device_id")
  incidentType    String           @default("WRONG_WAY") @map("incident_type")
  status          String           @default("ACTIVE")
  startedAt       DateTime         @default(now()) @map("started_at")
  resolvedAt      DateTime?        @map("resolved_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  zone            Zone             @relation(fields: [zoneId], references: [id])
  sourceDevice    Device           @relation(fields: [sourceDeviceId], references: [id])
  trafficEvents   TrafficEvent[]
  controlCommands ControlCommand[]

  @@index([zoneId, status])
  @@index([sourceDeviceId, status])
  @@index([startedAt])
  @@map("safety_incidents")
}

model DailyTrafficStat {
  id                     String   @id @default(cuid())
  statDate               DateTime @map("stat_date") @db.Date
  zoneId                 String   @map("zone_id")
  deviceId               String   @map("device_id")
  totalVehicleCount      Int      @default(0) @map("total_vehicle_count")
  normalVehicleCount     Int      @default(0) @map("normal_vehicle_count")
  wrongWayCount          Int      @default(0) @map("wrong_way_count")
  pedestrianEnteredCount Int      @default(0) @map("pedestrian_entered_count")
  pedestrianExitedCount  Int      @default(0) @map("pedestrian_exited_count")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  zone                   Zone     @relation(fields: [zoneId], references: [id])
  device                 Device   @relation(fields: [deviceId], references: [id])

  @@unique([statDate, zoneId, deviceId])
  @@index([zoneId, statDate])
  @@index([deviceId, statDate])
  @@map("daily_traffic_stats")
}

model ControlCommand {
  id             String          @id @default(cuid())
  incidentId     String?         @map("incident_id")
  controlBoardId String          @map("control_board_id")
  targetDeviceId String?         @map("target_device_id")
  commandType    String          @map("command_type")
  sequence       Int?
  status         String          @default("PENDING")
  requestedAt    DateTime        @default(now()) @map("requested_at")
  sentAt         DateTime?       @map("sent_at")
  acknowledgedAt DateTime?       @map("acknowledged_at")
  packetHex      String?         @map("packet_hex")
  responseHex    String?         @map("response_hex")
  errorMessage   String?         @map("error_message")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  incident       SafetyIncident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  controlBoard   Device          @relation("ControlBoardCommands", fields: [controlBoardId], references: [id])
  targetDevice   Device?         @relation("TargetDeviceCommands", fields: [targetDeviceId], references: [id], onDelete: SetNull)

  @@index([incidentId])
  @@index([controlBoardId, status])
  @@index([targetDeviceId])
  @@index([requestedAt])
  @@map("control_commands")
}

model EventLog {
  id        String        @id @default(cuid())
  eventId   String?       @map("event_id")
  userId    String?       @map("user_id")
  action    String
  message   String?
  metadata  Json?
  createdAt DateTime      @default(now()) @map("created_at")
  event     TrafficEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("event_logs")
}
